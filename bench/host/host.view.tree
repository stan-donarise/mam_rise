$rise_bench_host $mol_book2
	kind \goods
	pages /
		<= Controls $rise_bench_host_controls
			kind <= kind
			enabled <= controls_enabled true
			run_enabled <= run_enabled true
			running <= busy false
			engines? <=> selected_engines? /string
			sizes? <=> selected_counts? /string
			schemas? <=> selected_schemas? /string
			run? <=> run? null
			stop? <=> stop? null
			status <= status? \
			elapsed <= elapsed_text \
			retry_visible <= retry_visible false
			retry? <=> retry? null
		<= Results $mol_page
			title \Результаты
			minimal_width 640
			tools /
				<= Download $mol_button_download
					title <= csv_title \Скачать CSV
					hint \Скачать CSV
					blob <= csv_blob null
					file_name <= csv_filename \rise-benchmark.csv
				<= Mode $mol_switch
					value? <=> mode? \table
					options *
						table \Таблица
						charts \Графики
			body <= results_body /$mol_view
				<= History $mol_scroll
					sub /
						<= Metrics $rise_bench_metrics
							operations <= operations /string
							runs <= runs /$rise_bench_run
							compare <= compare false
							text_mode <= text_mode false
				<= Frame $mol_frame
					uri <= fixture_uri \
					clipboard_read false
					clipboard_write false
					attr *
						^
						inert <= busy false
	Charts $rise_bench_charts
		runs <= runs
		operations <= operations
