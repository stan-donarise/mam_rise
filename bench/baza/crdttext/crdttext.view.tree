$rise_bench_baza_crdttext $mol_book2
	menu_title <= title \Текст
	pages /
		<= Menu $mol_page
			title \CRDT text
			minimal_width 240
			body /
				<= Count_label $mol_labeler
					title \Количество строк
					Content <= Count $mol_switch
						value? <=> count_mode? \100
						enabled <= controls_enabled true
						options *
							100 \100
							500 \500
							1000 \1000
							2000 \2000
							5000 \5000
				<= Run $mol_button_major
					title \Запустить бенчмарк
					click? <=> benchmark? null
					enabled <= controls_enabled true
		<= Page $rise_bench_surface
			title <= page_title \CRDT-текст
			minimal_width 640
			body /
				<= Metrics $rise_bench_metrics
					text_mode true
					operations /
						\Вставка, с
						\Добавить символ, с
						\F5, с
				<= Reset $mol_button_minor
					title \Очистить
					click? <=> reset? null
					enabled <= controls_enabled
				<= Editor $rise_bench_textarea
					hint \Введите текст или запустите бенчмарк
					value? <=> text? \
					enabled <= controls_enabled
					spellcheck false
