$rise_bench_charts_selection $mol_pick
	runs /$rise_bench_run
	value? /string
	title <= selection_title \
	bubble_content /
		<= List $mol_scroll
			sub /
				<= Items $mol_list
					rows <= choices /$mol_view
	Presets $mol_view
		sub <= presets /$mol_view
	Preset*0 $mol_button_minor
		title <= preset_title* \
		click? <=> select_latest*? null
	Check* $mol_check_box
		title <= run_title* \
		checked? <=> checked*? false
