$rise_bench $mol_book2_catalog
	placeholders /
	param \bench
	spreads *
		$rise_bench_baza_goods <= Goods_host $rise_bench_host
			title \Сущности
			kind \goods
		$rise_bench_baza_crdttext <= Text_host $rise_bench_host
			title \Текст
			kind \text
	Goods $rise_bench_baza_goods
	Crdttext $rise_bench_baza_crdttext
	Idb $rise_bench_idb
