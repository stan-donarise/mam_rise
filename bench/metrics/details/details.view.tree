$rise_bench_metrics_details $mol_pick
	hint \Параметры компьютера и браузер
	trigger_content / <= Icon $mol_icon_information_outline
	bubble_content /
		<= Text $mol_view
			sub /
				<= Computer_label $mol_labeler
					title \Параметры компьютера
					label /
						\Параметры компьютера
						<= Copy $mol_button_copy
							hint \Копировать параметры компьютера
							text <= computer
							sub / <= Copy_icon $mol_icon_content_copy
					Content <= Computer $mol_view
						sub / <= computer \
				<= Browser_label $mol_labeler
					title \Браузер
					Content <= Browser $mol_view
						sub / <= browser \
